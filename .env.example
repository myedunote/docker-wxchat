# ============================================================
# docker-wxchat 环境变量示例
# 用法：cp .env.example .env  然后按需修改
# 注意：改完 .env 后必须 `docker compose up -d` 才会生效
#       （只 restart 不会重新读取 env_file）
# ============================================================

# —— 基础 ——
NODE_ENV=production
# 宿主机映射端口（容器内部固定 3000）
PORT=3000
# 时区：影响日志与容器内 date，前端时间显示由服务端 ISO 时间 + 浏览器本地时区渲染
TZ=Asia/Shanghai

# —— 存储（容器内路径，对应 compose 的两个 volume）——
DATABASE_PATH=/app/data/wxchat.db
UPLOAD_PATH=/app/uploads

# —— 安全（生产环境必须修改！）——
#
# ⚠ 关于 `$` 和 `#`：compose 读取本文件时**不是**原样透传，它会
#     · 对未加引号 / 双引号的值做 `$` 变量插值
#     · 把「空格 + #」之后的内容当行内注释截掉
#   所以下面这些写法都会被悄悄改写，而服务端只会回一句「密码错误」：
#       ACCESS_PASSWORD=P@$$w0rd2026     →  P@$w0rd2026   （$$ 折叠成一个 $）
#       ACCESS_PASSWORD=Pa$word          →  Pa            （$word 未定义 → 空串）
#       ACCESS_PASSWORD=my pass #2       →  my pass       （# 被当注释）
#   密码里含这些字符时，请用**单引号**包住（单引号内完全字面）：
#       ACCESS_PASSWORD='P@$$w0rd2026'
#   部署前可用 `npm run check:env` 核对「实际会传进容器的值」。
#
# 访问密码：登录用
ACCESS_PASSWORD=change-me-please
# JWT 密钥：请使用随机长字符串，例如 `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-random-long-secret
# 会话有效期（小时）
SESSION_EXPIRE_HOURS=24
# 连续登录失败多少次后锁定
MAX_LOGIN_ATTEMPTS=5
# 锁定时长（分钟）
LOGIN_LOCKOUT_MINUTES=15

# —— 清空数据 ——
# 留空（默认）：前端「滑动确认」即可清空，不再要求输入确认码
# 填值：作为可选的二次确认，前端会额外要求输入该确认码
CLEAR_CONFIRM_CODE=

# —— 上传限制 ——
# 单文件最大字节数，0 = 不限制（默认）
# 旧版本的 MAX_FILE_SIZE_MB=300 这类写法也会被自动换算兼容，
# 但建议直接用字节：300MB = 314572800
MAX_FILE_SIZE=0

# —— 消息加载 ——
# 单次加载条数默认值与硬上限（仅影响查询条数，不会删除任何历史数据）
MESSAGE_LOAD_DEFAULT=5000
MESSAGE_LOAD_MAX=100000

# —— 运行容器进程的 uid/gid（Linux 下 bind mount 权限用）——
# 若宿主机 data 与 uploads 目录属于别的用户，改成对应 uid/gid 即可
# 查询方式：stat -c '%u:%g' ./data
PUID=1000
PGID=1000

# —— 数据落盘位置（留空即用默认的相对路径）——
# 默认：仓库目录下的 ./data 与 ./uploads，clone 下来就能直接用。
# 想放到别处时**在这里改，不要去改 docker-compose.yml** ——
# 改 compose 文件会和后续 git pull 冲突。
# 例：DATA_DIR=/srv/wxchat/data
# 注意：这是宿主机上的路径，容器内路径固定为 /app/data 与 /app/uploads。
# 改了之后原来的数据不会自动搬过去，需要自己 mv。
# 这两个变量由 docker-compose 消费，不被 JS 读取（见 scripts/audit-env-usage.mjs）。
DATA_DIR=
UPLOAD_DIR=

# —— AI 对话（服务端代理，密钥不下发前端）——
# 总开关；同时需要填 AI_API_KEY 才算真正可用
AI_ENABLED=true
AI_API_KEY=
# 兼容 OpenAI 协议的 **base** 地址，代码内部会自动拼 /chat/completions。
# 因此这里不要带 /chat/completions 后缀（带了也会被自动去掉，但容易混淆）。
#   正确：https://api.siliconflow.cn/v1
#   正确：https://ai.example.com/v1
AI_API_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=deepseek-ai/DeepSeek-R1
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7
# 【预留，当前版本未强制】每分钟最大请求数。
# 变量会被识别（不会触发「拼写有误」告警），但服务端尚未实现限流逻辑，
# 配了不会真的限制。需要限流请在反向代理（Nginx / Caddy）层做。
AI_RATE_LIMIT=10

# 如果你是从旧的自托管版本迁移过来，可能沿用旧变量名。
# 下面三个旧名字会被自动兼容，并在启动日志里提示，无需改配置即可生效：
#   AI_CHAT_API_KEY   → AI_API_KEY
#   AI_CHAT_BASE_URL  → AI_API_BASE_URL
#   AI_CHAT_MODEL     → AI_MODEL

# —— AI 绘画（服务端代理，生成结果自动入库为消息）——
IMAGE_GEN_ENABLED=true
# 留空则回落到 AI_API_KEY
IMAGE_GEN_API_KEY=
# 留空则回落到 AI_API_BASE_URL
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=Kwai-Kolors/Kolors
IMAGE_GEN_DEFAULT_SIZE=1024x1024
# 【预留，当前版本未强制】同 AI_RATE_LIMIT，见上方说明。
IMAGE_RATE_LIMIT=5
